+/* AERA's private NAS test file: preserve fio's sync I/O, but open the
+ * pre-created empty file as a truncating write stream for uncached rclone. */
+static int fio_aera_nas_open(struct thread_data *td, struct fio_file *f)
+{
+	struct stat st;
+	char marker[22] = {0};
+	ssize_t length;
+	int owner, writing = td_write(td);
+	if (strcmp(f->file_name, "/proc/self/fd/6/data.bin") ||
+	    td_rw(td) || td_random(td) || td->o.odirect || td->o.numjobs != 1) {
+		td_verror(td, EINVAL, "aera_nas workload");
+		return 1;
+	}
+	owner = openat(6, "owner", O_RDONLY | O_NOFOLLOW);
+	if (owner < 0) return 1;
+	length = read(owner, marker, sizeof(marker));
+	close(owner);
+	if (length != 21 || memcmp(marker, "AERA-STORAGE-BENCH-1\n", 21) ||
+	    fstatat(6, "data.bin", &st, AT_SYMLINK_NOFOLLOW) ||
+	    !S_ISREG(st.st_mode) || (writing && st.st_size != 0)) {
+		td_verror(td, EPERM, "aera_nas private empty file");
+		return 1;
+	}
+	f->fd = openat(6, "data.bin", (writing ? O_WRONLY | O_TRUNC : O_RDONLY) | O_NOFOLLOW);
+	if (f->fd < 0) {
+		td_verror(td, errno, "aera_nas open");
+		return 1;
+	}
+	return 0;
+}
+
+static int fio_aera_nas_close(struct thread_data *td, struct fio_file *f)
+{
+	int result = close(f->fd);
+	(void) td;
+	f->fd = -1;
+	return result < 0 ? errno : 0;
+}
+
+static struct ioengine_ops ioengine_aera_nas = {
+	.name           = "aera_nas",
+	.version        = FIO_IOOPS_VERSION,
+	.prep           = fio_syncio_prep,
+	.queue          = fio_syncio_queue,
+	.open_file      = fio_aera_nas_open,
+	.close_file     = fio_aera_nas_close,
+	.get_file_size  = generic_get_file_size,
+	.flags          = FIO_SYNCIO | FIO_SYNCFS,
+};
+
 static struct ioengine_ops ioengine_rw = {
